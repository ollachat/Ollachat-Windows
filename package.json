{
  "name": "ollachat-windows",
  "version": "1.0.0",
  "description": "OllaChat Windows Desktop Application",
  "main": "dist/main/main.js",
  "type": "module",
  "author": "Ollacore",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node esbuild.config.js && electron .",
    "start": "node esbuild.config.js && electron .",
    "test": "node --test tests/*.test.js",
    "get-otp": "node scripts/get-otp.js",
    "package": "npm run build && electron-builder --dir --x64",
    "installer": "npm run build && electron-builder --win nsis --x64",
    "portable": "npm run build && electron-builder --win portable --x64",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "sqlite3": "^6.0.1",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "sqlite3@6.0.1": true
  }
}
